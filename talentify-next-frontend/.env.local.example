NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL for API requests. Leave blank to use the same origin as the frontend.
NEXT_PUBLIC_API_BASE=
# When deploying, keep this empty or set it to the same domain as the frontend
# so that API calls like `/api/csrf-token` do not trigger CORS errors.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NOTIFICATION_WEBHOOK_URL=https://example.com/webhook
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INVOICE_AUTO_APPROVE=true

# Transactional email notifications (Resend).
# Keep disabled until RESEND_API_KEY and a verified sender are configured.
NOTIFICATION_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=来店ナビ <noreply@example.com>

# Contact form operator notification.
# Inquiries are always stored in Supabase even when this is disabled.
CONTACT_EMAIL_ENABLED=false
CONTACT_NOTIFICATION_EMAIL=

# YouTube Data API v3 (server only). Used to sync channel subscriber counts.
YOUTUBE_API_KEY=

# Social follower metrics (server only)
# X: Developer Console bearer token.
X_BEARER_TOKEN=

# Instagram Business Discovery.
# Requires a professional Instagram account connected to the Meta app.
INSTAGRAM_BUSINESS_DISCOVERY_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=

# TikTok Login Kit.
# Register this redirect URI in TikTok Developer Portal:
# <NEXT_PUBLIC_SITE_URL>/api/talent/social/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
